# Orion AI — client environment. The onboarding wizard (deploy/orion-setup.mjs)
# fills these in for you; you can also edit here directly. Leave blank to skip.

# --- Telegram (talk to your assistant from your phone) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Email sending ---
RESEND_API_KEY=

# --- Tailscale (optional: set to auto-join the private network headlessly) ---
# Generate at https://login.tailscale.com/admin/settings/keys and paste here,
# or leave blank and run `tailscale up` once to log in via browser.
TS_AUTHKEY=
