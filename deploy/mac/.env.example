# ---------------------------------------------------------------------------
# Orion AI - Mac assistant.  Fill these in with:  npm run setup
# Nothing here is optional except where marked.
# ---------------------------------------------------------------------------

# Who this install belongs to. Shows up in Telegram and in Orion's support texts.
CLIENT_NAME=

# --- Telegram (the control channel) ----------------------------------------
# From @BotFather: /newbot -> it hands you a token.
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric user ID. Get it from @userinfobot.
# LEAVE THIS EMPTY AND NOBODY CAN USE THE BOT - that is the safe default.
TELEGRAM_ALLOWED_USER_IDS=

# --- DeepSeek (writes every message and post) ------------------------------
# platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Reddit (optional; needed for /reddit) ---------------------------------
# reddit.com/prefs/apps -> create app -> type "script"
# NOTE: this login path cannot pass 2FA. Use a dedicated posting account
# without 2FA, or leave Reddit off.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=

# --- Support relay (lets this machine text Orion) --------------------------
# Orion fills these in. ORION_TELEGRAM_CHAT_ID is his chat with the relay bot.
ORION_RELAY_BOT_TOKEN=
ORION_TELEGRAM_CHAT_ID=
# Orion's Telegram user ID - gives him admin commands on this bot (/diag /logs /say)
ORION_ADMIN_TELEGRAM_IDS=
ORION_SUPPORT_EMAIL=orionjones99@gmail.com
ORION_SUPPORT_PHONE=424-422-5031

# --- Booking -------------------------------------------------------------
# ORION_SLOTS_URL should answer GET -> {slots:[{startISO,label}]} and accept
# POST {start,name,reason}. Leave it blank and the Book a call screen still
# works: it relays the request to Orion rather than guessing at a time.
ORION_SLOTS_URL=
ORION_BOOK_URL=https://book.orion-jones.com

# --- Behaviour -------------------------------------------------------------
# Timezone used for active-hours checks.
ORION_TZ=America/Los_Angeles
# Set to 1 to run browsers with a visible window (some sites block headless).
ORION_HEADFUL=0

# --- Remote status page ----------------------------------------------------
# The board at http://<this-mac>:8791 — same view as the terminal and Telegram.
# STATUS_BIND=127.0.0.1 keeps it local; 0.0.0.0 makes it reachable over your
# Tailscale network (a private network, not the public internet).
# STATUS_TOKEN is required once exposed; the installer generates one if blank.
STATUS_PORT=8791
STATUS_BIND=127.0.0.1
STATUS_TOKEN=
